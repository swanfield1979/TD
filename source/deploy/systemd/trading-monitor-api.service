[Unit]
Description=Trading Monitor IBKR read-only API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trading-monitor
Group=trading-monitor
WorkingDirectory=/opt/trading-monitor/source
EnvironmentFile=/etc/trading-monitor/ibkr.env
ExecStart=/bin/bash /opt/trading-monitor/source/server/start-api.sh
Restart=on-failure
RestartSec=5
StateDirectory=trading-monitor
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/trading-monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
