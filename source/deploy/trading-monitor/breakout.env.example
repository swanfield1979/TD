# Optional scanner service configuration. Never add IBKR usernames/passwords.
# Paper IB Gateway defaults; paper TWS uses 7497.
BREAKOUT_BROKER_HOST=127.0.0.1
BREAKOUT_BROKER_PORT=4002
BREAKOUT_BROKER_CLIENT_ID=109
BREAKOUT_DATABASE_PATH=/var/lib/trading-monitor/breakout.sqlite
BREAKOUT_ALLOWED_ORIGINS=http://192.168.1.22
BREAKOUT_REQUEST_INTERVAL=11
BREAKOUT_REQUEST_LIMIT=55
BREAKOUT_PACING_WINDOW=600
BREAKOUT_MAX_ATTEMPTS=3
BREAKOUT_BACKOFF_BASE=2
BREAKOUT_BACKOFF_CAP=30
BREAKOUT_REQUEST_TIMEOUT=45
