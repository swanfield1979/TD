# Niet-geheime voorbeelden; kopieer naar .env. Geen IBKR-wachtwoord nodig.
# TWS paper, unieke client-ID. Gateway paper gebruikt normaal poort 4002.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_READ_ONLY=true
DATABASE_URL=sqlite:///./data/private/leader_scan.db
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_CURRENCY=USD
DEFAULT_EXCHANGE=SMART
BREAKOUT_REQUEST_INTERVAL=11
BREAKOUT_REQUEST_LIMIT=55
BREAKOUT_PACING_WINDOW=600
# Parallelle brokerhistorie blijft bewust 1; configureer via PUT /api/settings.
